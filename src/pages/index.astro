---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrbitField from "../components/OrbitField.astro";

const sections = [
  {
    eyebrow: "01 · Verfügbar",
    title: "Tools",
    body: "Interaktive Werkzeuge, um gemeinsam Klarheit zu finden — den Anfang macht das Relationship Anarchy Smörgåsbord-Board.",
    href: "/tools",
    cta: "Tools entdecken",
  },
  {
    eyebrow: "02 · Im Aufbau",
    title: "Ressourcen",
    body: "Kuratierte Artikel, Guides und Links rund um Non-Monogamie, Polyamorie und Relationship Anarchy.",
    href: "/ressourcen",
    cta: "Ressourcen ansehen",
  },
  {
    eyebrow: "03 · Im Aufbau",
    title: "Glossar",
    body: "Begriffe wie Polyamorie, Metamour oder Kitchen-Table-Poly — verständlich erklärt, ohne Fachjargon.",
    href: "/glossar",
    cta: "Glossar öffnen",
  },
  {
    eyebrow: "04 · Bald",
    title: "Coachings & Kurse",
    body: "Begleitung und Formate für alle, die ihre Beziehungen bewusster gestalten wollen.",
    href: "/coaching",
    cta: "Mehr erfahren",
  },
];
---

<BaseLayout title="no labels.">
  <section class="relative isolate overflow-hidden px-5 pb-20 pt-16 sm:px-8 sm:pt-24">
    <OrbitField />

    <div class="mx-auto max-w-3xl">
      <p class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">
        nolabels.love
      </p>
      <h1 class="mt-5 font-display text-4xl font-medium leading-[1.1] text-[var(--color-ink)] sm:text-6xl">
        Beziehungen, die zu dir passen —
        <span class="italic text-[var(--color-primary)]">nicht zu einem Label.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
        Ein wachsender Werkzeugkasten mit Tools, Ressourcen und Begriffen für
        Beziehungen jenseits vorgegebener Schablonen — mit Schwerpunkt auf
        Non-Monogamie, Polyamorie und Relationship Anarchy.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="/tools"
          class="rounded-full bg-[var(--color-ink)] px-7 py-3 text-sm font-semibold text-[var(--color-bg)] transition-transform hover:-translate-y-0.5"
        >
          Zu den Tools
        </a>
        <a
          href="/glossar"
          class="rounded-full border border-[var(--color-ink)]/20 px-7 py-3 text-sm font-semibold text-[var(--color-ink)] transition-colors hover:bg-[var(--color-bg-soft)]"
        >
          Begriffe nachschlagen
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        sections.map((section) => (
          <a
            href={section.href}
            class="group flex flex-col justify-between rounded-3xl border border-[var(--color-line)] bg-white/60 p-7 transition-colors hover:border-[var(--color-primary)]/40 hover:bg-white"
          >
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-muted)]">
                {section.eyebrow}
              </p>
              <h2 class="mt-3 font-display text-2xl font-medium text-[var(--color-ink)]">{section.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">{section.body}</p>
            </div>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-primary)]">
              {section.cta}
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
