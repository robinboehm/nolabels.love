---
import BaseLayout from "../layouts/BaseLayout.astro";

const resources = [
  {
    title: "Relationship Anarchy Guide",
    source: "The Relationship Anarchist",
    href: "https://www.therelationshipanarchist.com/relationship-anarchy-guide",
    description:
      "Einstiegs-Guide mit mehreren Bausteinen: Grundprinzipien von Relationship Anarchy (Ablehnung zwischenmenschlichen Zwangs, Bedeutung von Community, Mutual Aid als zentrale Stütze, Commitments als Kommunikation statt Vertrag); eine kritische Erklärung der „Relationship Escalator“-Norm — dem gesellschaftlich erwarteten Stufenplan von Flirten bis Heirat und Kinder; eine eigene, knappere Variante des Relationship Smorgasbord samt Worksheet; sowie eine Abgrenzung von Relationship Anarchy zu Polyamorie/„Ethical Non-Monogamy“.",
  },
];
---

<BaseLayout
  title="Ressourcen"
  description="Kuratierte Artikel, Guides und Links rund um Non-Monogamie, Polyamorie und Relationship Anarchy."
>
  <section class="mx-auto max-w-3xl px-5 pb-20 pt-16 sm:px-8 sm:pt-20">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">Ressourcen</p>
    <h1 class="mt-4 font-display text-4xl font-medium text-[var(--color-ink)] sm:text-5xl">
      Artikel &amp; Guides
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink-soft)]">
      Eine wachsende Sammlung von Links rund um offene Beziehungen,
      Polyamorie und Relationship Anarchy. Noch am Anfang — wird laufend
      erweitert.
    </p>

    <ul class="mt-12 flex flex-col gap-6">
      {
        resources.map((resource) => (
          <li class="rounded-3xl border border-[var(--color-line)] bg-white/60 p-7">
            <a
              href={resource.href}
              target="_blank"
              rel="noopener"
              class="font-display text-2xl font-medium text-[var(--color-ink)] hover:text-[var(--color-primary)]"
            >
              {resource.title} ↗
            </a>
            <p class="mt-1 text-sm font-semibold text-[var(--color-muted)]">{resource.source}</p>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">{resource.description}</p>
          </li>
        ))
      }

      <li class="rounded-3xl border border-dashed border-[var(--color-line)] p-7 text-[var(--color-muted)]">
        <span class="inline-block rounded-full bg-[var(--color-accent)]/20 px-3 py-1 text-xs font-semibold text-[var(--color-primary-dark)]">
          Bald
        </span>
        <p class="mt-3 text-sm leading-relaxed">Weitere Ressourcen sind in Arbeit.</p>
      </li>
    </ul>
  </section>
</BaseLayout>
