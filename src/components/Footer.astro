---
import { getRelativeLocaleUrl } from "astro:i18n";
import { FOOTER_EXTRA_ITEMS, NAV_ITEMS } from "../i18n/nav";
import { UI } from "../i18n/ui";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = [...NAV_ITEMS[locale], ...FOOTER_EXTRA_ITEMS[locale]];
const ui = UI[locale];
const year = new Date().getFullYear();

function hrefFor(path: string): string {
  return getRelativeLocaleUrl(locale, path === "/" ? "" : path);
}
---

<footer class="border-t border-[var(--color-line)] bg-[var(--color-bg-soft)]">
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-lg font-medium text-[var(--color-ink)]">
          no labels<span class="text-[var(--color-primary)]">.</span>
        </p>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{ui.footerTagline}</p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-[var(--color-ink-soft)]" aria-label="Footer navigation">
        {
          items.map((item) => (
            <a href={hrefFor(item.path)} class="hover:text-[var(--color-ink)]">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-[var(--color-line)] pt-6 text-xs text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} nolabels.love</p>
      <p>
        {ui.footerBoardLicensePrefix}{" "}
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-[var(--color-ink-soft)]"
        >
          CC BY-NC-SA 4.0
        </a>.
      </p>
    </div>
  </div>
</footer>
