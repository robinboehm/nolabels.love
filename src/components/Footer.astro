---
import { NAV_ITEMS } from "../lib/nav";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--color-line)] bg-[var(--color-bg-soft)]">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <a href="/" class="font-display text-lg font-medium text-[var(--color-ink)]">
          no labels<span class="text-[var(--color-primary)]">.</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Ressourcen und Tools für Beziehungen jenseits vorgegebener Schablonen —
          mit Schwerpunkt auf Non-Monogamie, Polyamorie und Relationship Anarchy.
        </p>
      </div>

      <nav aria-label="Footer-Navigation" class="flex flex-wrap gap-x-8 gap-y-2 text-sm">
        {
          NAV_ITEMS.map((item) => (
            <a href={item.href} class="text-[var(--color-ink-soft)] hover:text-[var(--color-primary)]">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-[var(--color-line)] pt-6 text-xs text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} nolabels.love</p>
      <p>
        Das Board basiert auf dem Relationship Anarchy Smörgåsbord (v6),
        lizenziert unter
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          target="_blank"
          rel="noopener"
          class="underline decoration-[var(--color-line)] underline-offset-2 hover:text-[var(--color-primary)]"
        >
          CC BY-NC-SA 4.0
        </a>.
      </p>
    </div>
  </div>
</footer>
