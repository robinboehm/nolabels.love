---
import { getRelativeLocaleUrl } from "astro:i18n";
import { NAV_ITEMS } from "../i18n/nav";
import { UI } from "../i18n/ui";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  /** Locale-independent current path, e.g. "/tools/board". */
  path: string;
  /** Precomputed URL for the same page in the other locale. */
  altHref: string;
}

const { locale, path, altHref } = Astro.props;
const items = NAV_ITEMS[locale];
const ui = UI[locale];
const normalizedPath = path.replace(/\/+$/, "") || "/";

function isActive(itemPath: string): boolean {
  const normalized = itemPath.replace(/\/+$/, "") || "/";
  if (normalized === "/") return normalizedPath === "/";
  return normalizedPath === normalized || normalizedPath.startsWith(`${normalized}/`);
}

function hrefFor(itemPath: string): string {
  return getRelativeLocaleUrl(locale, itemPath === "/" ? "" : itemPath);
}
---

<header class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-[var(--color-bg)]/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a
      href={hrefFor("/")}
      class="font-display text-xl font-medium tracking-tight text-[var(--color-ink)]"
      aria-label="nolabels.love"
    >
      no labels<span class="text-[var(--color-primary)]">.</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main navigation">
      {
        items.map((item) => (
          <a
            href={hrefFor(item.path)}
            class={`relative rounded-full px-4 py-2 text-sm font-medium transition-colors ${
              isActive(item.path)
                ? "bg-[var(--color-ink)] text-[var(--color-bg)]"
                : "text-[var(--color-ink-soft)] hover:bg-[var(--color-bg-soft)]"
            }`}
            aria-current={isActive(item.path) ? "page" : undefined}
          >
            {item.label}
            {item.comingSoon && (
              <span class="ml-1.5 rounded-full bg-[var(--color-accent)]/25 px-1.5 py-0.5 text-[0.65rem] font-semibold tracking-wide text-[var(--color-primary-dark)]">
                {ui.comingSoonBadge}
              </span>
            )}
          </a>
        ))
      }

      <a
        href={altHref}
        class="ml-2 rounded-full border border-[var(--color-line)] px-3 py-2 text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-soft)] hover:bg-[var(--color-bg-soft)]"
        aria-label={ui.langSwitchAriaLabel}
      >
        {locale === "de" ? "EN" : "DE"}
      </a>
    </nav>

    <div class="flex items-center gap-2 lg:hidden">
      <a
        href={altHref}
        class="rounded-full border border-[var(--color-line)] px-3 py-2 text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-soft)]"
        aria-label={ui.langSwitchAriaLabel}
      >
        {locale === "de" ? "EN" : "DE"}
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex items-center justify-center rounded-full border border-[var(--color-line)] p-2 text-[var(--color-ink)]"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={ui.menuOpen}
      >
        <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden flex-col gap-1 border-t border-[var(--color-line)] px-5 pb-4 pt-2 lg:hidden"
    aria-label="Main navigation (mobile)"
  >
    {
      items.map((item) => (
        <a
          href={hrefFor(item.path)}
          class={`flex items-center justify-between rounded-xl px-4 py-3 text-base font-medium ${
            isActive(item.path)
              ? "bg-[var(--color-ink)] text-[var(--color-bg)]"
              : "text-[var(--color-ink-soft)] hover:bg-[var(--color-bg-soft)]"
          }`}
          aria-current={isActive(item.path) ? "page" : undefined}
        >
          {item.label}
          {item.comingSoon && (
            <span class="rounded-full bg-[var(--color-accent)]/25 px-2 py-0.5 text-xs font-semibold tracking-wide text-[var(--color-primary-dark)]">
              {ui.comingSoonBadge}
            </span>
          )}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("flex");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
