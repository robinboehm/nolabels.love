---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EVENTS_CONTENT } from "../i18n/content/events";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = EVENTS_CONTENT[locale];
---

<BaseLayout locale={locale} path="/events" title={content.title} description={content.description}>
  <section class="mx-auto max-w-3xl px-5 pb-20 pt-16 sm:px-8 sm:pt-20">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{content.eyebrow}</p>
    <h1 class="mt-4 font-display text-4xl font-medium text-[var(--color-ink)] sm:text-5xl">
      {content.heading}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink-soft)]">
      {content.intro}
    </p>

    <ul class="mt-12 flex flex-col gap-6">
      {
        content.events.map((event) => (
          <li class="rounded-3xl border border-[var(--color-line)] bg-white/60 p-7">
            <span class="inline-block rounded-full bg-[var(--color-secondary-soft)] px-3 py-1 text-xs font-semibold text-[var(--color-secondary)]">
              {event.type}
            </span>
            <p class="mt-3 font-display text-2xl font-medium text-[var(--color-ink)]">{event.name}</p>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">{event.description}</p>
            {(event.telegramUrl || event.websiteUrl) && (
              <div class="mt-4 flex flex-wrap gap-4 text-sm font-semibold">
                {event.telegramUrl && (
                  <a href={event.telegramUrl} target="_blank" rel="noopener" class="text-[var(--color-primary)] hover:underline">
                    {content.telegramLabel} ↗
                  </a>
                )}
                {event.websiteUrl && (
                  <a href={event.websiteUrl} target="_blank" rel="noopener" class="text-[var(--color-primary)] hover:underline">
                    {content.websiteLabel} ↗
                  </a>
                )}
              </div>
            )}
          </li>
        ))
      }

      <li class="rounded-3xl border border-dashed border-[var(--color-line)] p-7 text-[var(--color-muted)]">
        <span class="inline-block rounded-full bg-[var(--color-accent)]/20 px-3 py-1 text-xs font-semibold text-[var(--color-primary-dark)]">
          {content.comingSoonTitle}
        </span>
        <p class="mt-3 text-sm leading-relaxed">{content.comingSoonBody}</p>
      </li>
    </ul>
  </section>
</BaseLayout>
