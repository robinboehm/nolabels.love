---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { RESSOURCEN_CONTENT } from "../i18n/content/ressourcen";
import type { Locale } from "../i18n/locales";
import { linkListNode } from "../seo/jsonld";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = RESSOURCEN_CONTENT[locale];
const url = getAbsoluteLocaleUrl(locale, "ressourcen");
const jsonLd = [
  linkListNode(
    url,
    content.heading,
    content.resources.map((r) => ({ name: r.title, url: r.href, description: r.description })),
  ),
];
---

<BaseLayout locale={locale} path="/ressourcen" title={content.title} description={content.description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-5 pb-20 pt-16 sm:px-8 sm:pt-20">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{content.eyebrow}</p>
    <h1 class="mt-4 font-display text-4xl font-medium text-[var(--color-ink)] sm:text-5xl">
      {content.heading}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink-soft)]">
      {content.intro}
    </p>

    <ul class="mt-12 flex flex-col gap-6">
      {
        content.resources.map((resource) => (
          <li class="rounded-3xl border border-[var(--color-line)] bg-white/60 p-7">
            <a
              href={resource.href}
              target="_blank"
              rel="noopener"
              class="font-display text-2xl font-medium text-[var(--color-ink)] hover:text-[var(--color-primary)]"
            >
              {resource.title} ↗
            </a>
            <p class="mt-1 text-sm font-semibold text-[var(--color-muted)]">{resource.source}</p>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">{resource.description}</p>
          </li>
        ))
      }

      <li class="rounded-3xl border border-dashed border-[var(--color-line)] p-7 text-[var(--color-muted)]">
        <span class="inline-block rounded-full bg-[var(--color-accent)]/20 px-3 py-1 text-xs font-semibold text-[var(--color-primary-dark)]">
          {content.comingSoonTitle}
        </span>
        <p class="mt-3 text-sm leading-relaxed">{content.comingSoonBody}</p>
      </li>
    </ul>
  </section>
</BaseLayout>
