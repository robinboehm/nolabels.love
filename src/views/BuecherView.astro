---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BUECHER_CONTENT } from "../i18n/content/buecher";
import type { Locale } from "../i18n/locales";
import { bookListNode } from "../seo/jsonld";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = BUECHER_CONTENT[locale];
const url = getAbsoluteLocaleUrl(locale, "buecher");
const jsonLd = [bookListNode(url, content.heading, content.books)];
---

<BaseLayout locale={locale} path="/buecher" title={content.title} description={content.description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-5 pb-20 pt-16 sm:px-8 sm:pt-20">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{content.eyebrow}</p>
    <h1 class="mt-4 font-display text-4xl font-medium text-[var(--color-ink)] sm:text-5xl">
      {content.heading}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink-soft)]">
      {content.intro}
    </p>

    <ul class="mt-12 flex flex-col gap-6">
      {
        content.books.map((book) => (
          <li class="flex flex-col gap-5 rounded-3xl border border-[var(--color-line)] bg-white/60 p-6 sm:flex-row sm:gap-7 sm:p-7">
            <img
              src={book.cover}
              alt={`${content.coverAlt}: ${book.title}`}
              width="160"
              height="240"
              loading="lazy"
              decoding="async"
              class="h-auto w-24 shrink-0 self-start rounded-md shadow-md ring-1 ring-black/5 sm:w-28"
            />
            <div class="min-w-0">
              <p lang={book.language} class="font-display text-2xl font-medium text-[var(--color-ink)]">{book.title}</p>
              {book.subtitle && <p lang={book.language} class="mt-1 text-sm text-[var(--color-ink-soft)]">{book.subtitle}</p>}
              <p class="mt-2 text-sm font-semibold text-[var(--color-muted)]">{book.author}</p>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">{book.summary}</p>
              <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-[var(--color-muted)]">
                <span class="rounded-full bg-[var(--color-accent)]/20 px-2.5 py-0.5 font-semibold text-[var(--color-primary-dark)]">
                  {content.languageLabels[book.language]}
                </span>
                {book.publisher && <span>{book.publisher}</span>}
                {book.isbn && <span>ISBN {book.isbn}</span>}
              </p>
            </div>
          </li>
        ))
      }

      <li class="rounded-3xl border border-dashed border-[var(--color-line)] p-7 text-[var(--color-muted)]">
        <span class="inline-block rounded-full bg-[var(--color-accent)]/20 px-3 py-1 text-xs font-semibold text-[var(--color-primary-dark)]">
          {content.comingSoonTitle}
        </span>
        <p class="mt-3 text-sm leading-relaxed">{content.comingSoonBody}</p>
      </li>
    </ul>
  </section>
</BaseLayout>
