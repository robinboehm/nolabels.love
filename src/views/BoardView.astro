---
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BOARD_CONTENT } from "../i18n/content/board";
import type { Locale } from "../i18n/locales";
import { boardAppNode } from "../seo/jsonld";
import { BOARD_APP_PATH } from "../seo/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = BOARD_CONTENT[locale];
const jsonLd = [boardAppNode(content.title, content.description)];
---

<BaseLayout locale={locale} path="/tools/board" title={content.title} description={content.description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-5 pb-20 pt-16 sm:px-8 sm:pt-20">
    <a href={getRelativeLocaleUrl(locale, "tools")} class="text-sm font-semibold text-[var(--color-primary)] hover:underline">
      {content.backLabel}
    </a>

    <p class="mt-6 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{content.eyebrow}</p>
    <h1 class="mt-3 font-display text-4xl font-medium text-[var(--color-ink)] sm:text-5xl">
      {content.heading}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink-soft)]">
      {content.intro}
    </p>

    <div class="mt-9">
      <a
        href={BOARD_APP_PATH}
        class="inline-flex items-center gap-2 rounded-full bg-[var(--color-ink)] px-7 py-3.5 text-sm font-semibold text-[var(--color-bg)] transition-transform hover:-translate-y-0.5"
      >
        {content.openCta}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        content.cards.map((card, i) => (
          <div class={`rounded-3xl border border-[var(--color-line)] bg-white/60 p-6 ${i === content.cards.length - 1 ? "sm:col-span-2" : ""}`}>
            <h2 class="font-display text-xl font-medium text-[var(--color-ink)]">{card.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">{card.body}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-xs leading-relaxed text-[var(--color-muted)]">
      {content.licenseNote}{" "}
      <a
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
        target="_blank"
        rel="noopener"
        class="underline decoration-[var(--color-line)] underline-offset-2 hover:text-[var(--color-primary)]"
      >CC BY-NC-SA 4.0</a>.
    </p>
  </section>
</BaseLayout>
