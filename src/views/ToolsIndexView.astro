---
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { TOOLS_CONTENT } from "../i18n/content/tools";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = TOOLS_CONTENT[locale];
---

<BaseLayout locale={locale} path="/tools" title={content.title} description={content.description}>
  <section class="mx-auto max-w-4xl px-5 pb-20 pt-16 sm:px-8 sm:pt-20">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{content.eyebrow}</p>
    <h1 class="mt-4 font-display text-4xl font-medium text-[var(--color-ink)] sm:text-5xl">
      {content.heading}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
      {content.intro}
    </p>

    <div class="mt-12 flex flex-col gap-5">
      {
        content.tools.map((tool) => (
          <a
            href={getRelativeLocaleUrl(locale, tool.path.replace(/^\//, ""))}
            class="group flex flex-col gap-3 rounded-3xl border border-[var(--color-line)] bg-white/60 p-7 transition-colors hover:border-[var(--color-primary)]/40 hover:bg-white sm:flex-row sm:items-center sm:justify-between sm:gap-6"
          >
            <div>
              <span class="inline-block rounded-full bg-[var(--color-secondary-soft)] px-3 py-1 text-xs font-semibold text-[var(--color-secondary)]">
                {tool.status}
              </span>
              <h2 class="mt-3 font-display text-2xl font-medium text-[var(--color-ink)]">{tool.title}</h2>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-[var(--color-ink-soft)]">{tool.description}</p>
            </div>
            <span class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-full bg-[var(--color-ink)] px-5 py-2.5 text-sm font-semibold text-[var(--color-bg)] sm:self-center">
              {content.openCta}
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))
      }

      <div class="flex flex-col gap-3 rounded-3xl border border-dashed border-[var(--color-line)] p-7 text-[var(--color-muted)]">
        <span class="inline-block w-fit rounded-full bg-[var(--color-accent)]/20 px-3 py-1 text-xs font-semibold text-[var(--color-primary-dark)]">
          {content.comingSoonTitle}
        </span>
        <p class="text-sm leading-relaxed">{content.comingSoonBody}</p>
      </div>
    </div>
  </section>
</BaseLayout>
