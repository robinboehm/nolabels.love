---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { FAQ_CONTENT } from "../i18n/content/faq";
import type { Locale } from "../i18n/locales";
import { faqPageNode } from "../seo/jsonld";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = FAQ_CONTENT[locale];
const url = getAbsoluteLocaleUrl(locale, "faq");
const jsonLd = [faqPageNode(url, content.groups, locale)];
---

<BaseLayout locale={locale} path="/faq" title={content.title} description={content.description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-5 pb-20 pt-16 sm:px-8 sm:pt-20">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{content.eyebrow}</p>
    <h1 class="mt-4 font-display text-4xl font-medium text-[var(--color-ink)] sm:text-5xl">{content.heading}</h1>
    <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink-soft)]">
      {content.intro}
    </p>

    {
      content.groups.map((group) => (
        <div class="mt-14">
          <h2 class="font-display text-2xl font-medium text-[var(--color-ink)]">{group.heading}</h2>
          <div class="mt-4 flex flex-col divide-y divide-[var(--color-line)]">
            {group.entries.map((entry) => (
              <div class="py-6">
                <h3 class="font-display text-lg font-medium text-[var(--color-ink)]">{entry.question}</h3>
                <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">{entry.answer}</p>
              </div>
            ))}
          </div>
        </div>
      ))
    }

    <p class="mt-12 text-xs leading-relaxed text-[var(--color-muted)]">
      {content.machineReadableNote}{" "}
      <a href="/llms.txt" class="underline decoration-[var(--color-line)] underline-offset-2 hover:text-[var(--color-primary)]">/llms.txt</a>
      {" · "}
      <a href="/llms-full.txt" class="underline decoration-[var(--color-line)] underline-offset-2 hover:text-[var(--color-primary)]">/llms-full.txt</a>
    </p>
  </section>
</BaseLayout>
