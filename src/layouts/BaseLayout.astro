---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LOCALES, otherLocale, type Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  /** Locale-independent path (e.g. "/tools/board"), used for hreflang + the language switcher. */
  path: string;
  title: string;
  description: string;
}

const { locale, path, title, description } = Astro.props;

const suffix = locale === "de" ? "no labels." : "no labels.";
const pageTitle = title === "no labels." ? title : `${title} — ${suffix}`;
const alt = otherLocale(locale);
const altHref = getRelativeLocaleUrl(alt, path === "/" ? "" : path);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f8f1ec" />
    {
      LOCALES.map((loc) => (
        <link
          rel="alternate"
          hreflang={loc}
          href={getRelativeLocaleUrl(loc, path === "/" ? "" : path, { normalizeLocale: false })}
        />
      ))
    }
  </head>
  <body class="flex min-h-screen flex-col font-body text-[var(--color-ink)] antialiased">
    <Header locale={locale} path={path} altHref={altHref} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
